[Unit]
Description=SkillWiki HTTP MCP agent-memory research
Documentation=file:/opt/llm-wiki/packages/agent-memory-trends/README.md
After=network-online.target skillwiki-mcp.service
Wants=network-online.target

[Service]
Type=oneshot
User=skillwiki-research
Group=skillwiki-research
WorkingDirectory=/opt/llm-wiki
Environment=HOME=/var/lib/skillwiki-research
Environment=AGENT_MEMORY_TRENDS_MCP_WRITER_ID=sg01-research
EnvironmentFile=/etc/skillwiki-research/env
StateDirectory=skillwiki-research
StateDirectoryMode=0700
ExecStart=/usr/bin/node /opt/llm-wiki/packages/agent-memory-trends/dist/cli.js daily --generate-only --mcp-publish --synthesis-fallback none --vault /var/lib/skillwiki-research/staging-vault --repo /opt/llm-wiki --config /etc/skillwiki-research/agent-memory-research-sources.yaml
RuntimeMaxSec=1800
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/skillwiki-research

